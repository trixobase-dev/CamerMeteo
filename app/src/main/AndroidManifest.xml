<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ApplicationManager"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/iv_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/iv_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.CamerMétéo">
        <activity
            android:name=".ui.view.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.view.setting.SettingActivity"
            android:exported="false" />
        <activity
            android:name=".ui.view.town.TownActivity"
            android:exported="false" />
        <activity
            android:name=".ui.view.region.RegionActivity"
            android:exported="false"
            android:noHistory="true" />
        <activity
            android:name=".ui.view.AboutActivity"
            android:exported="false" />
    </application>

</manifest>