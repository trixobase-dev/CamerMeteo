<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/iv_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/iv_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Application">

        <activity
            android:name=".ui.view.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.view.setting.SettingActivity" />
        <activity android:name=".ui.view.town.CityActivity" />
        <activity android:name=".ui.view.region.RegionActivity" />
        <activity android:name=".ui.view.AboutActivity" />

    </application>

</manifest>